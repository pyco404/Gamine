# Copy these entries into web/.env.local. Never commit actual credentials.
NEXT_PUBLIC_LAUNCHPAD=1
NEXT_PUBLIC_LAUNCHPAD_MODE=pump
# Canonical public site address.
NEXT_PUBLIC_SITE_URL=https://trygamine.xyz
# NEXT_PUBLIC_SOCIAL_X_URL=https://x.com/trygamine
# Public GitHub links remain generic until the repository is revealed.
PUMP_RPC_URL=https://your-mainnet-rpc-endpoint
PINATA_JWT=your-server-side-pinata-jwt
# Optional pre-generated official mint (server-only; no vanity suffix required).
# GAMINE_LAUNCHER_WALLET=Gh8BDiUhocbkrwaFv755y75dbH7QgzmaVJdF1SqYRi9H
# GAMINE_LAUNCH_MINT_SECRET=<private keypair JSON; never commit the real value>
# Public receiving addresses: 30% platform, 70% shared agent rewards.
# Platform also receives the 0.05 SOL launch fee.
PUMP_PLATFORM_WALLET=D135SVgjLuk3X4dLwDu4SypWXZc2ggit9jUh8cJhsN2t
PUMP_AGENT_REWARDS_WALLET=AYJxAZ3fug7fvyEWtdtE5HzpS7Fa6HGuvvrNvojTNKcF
# Generate once with npm run pump:setup (see docs/pump-launchpad.md).
PUMP_LOOKUP_TABLE=your-frozen-mainnet-lookup-table-address
# A file on a persistent volume is required in production.
PUMP_LAUNCH_DB_PATH=/absolute/path/on/persistent-volume/launchpad.sqlite
# Enable only after the RPC, IPFS and lookup table are configured.
PUMP_LAUNCH_ENABLED=false
# Optional; otherwise NEXT_PUBLIC_API_URL is used for wallet session checks.
# LAUNCHPAD_AUTH_API_URL=https://your-gamine-api

# Reward payouts: collect SOL, swap approved batches into $GAMINE at payout.
# Use the REAL mainnet $GAMINE mint. Your reward wallet signs each step; no private keys belong here.
PAYOUT_AGP_MINT=
# Server-only key for Jupiter swaps; never prefix with NEXT_PUBLIC_.
JUPITER_API_KEY=
# Enable after configuration and a small reviewed payout. Approval alone never sends funds.
PAYOUT_EXECUTION_ENABLED=false
# SOL reserved beyond the budget for rent, network and swap costs.
PAYOUT_FEE_RESERVE_SOL=0.05
PAYOUT_MAX_TX_COST_SOL=0.01
# Maximum quoted price impact: 200 basis points = 2%.
PAYOUT_MAX_PRICE_IMPACT_BPS=200
