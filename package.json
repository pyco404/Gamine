{
  "name": "gamine",
  "version": "0.0.1",
  "private": true,
  "description": "Gamine match engine — agent-versus-agent betting game.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "balance": "tsx scripts/balance.ts",
    "check": "npm run typecheck && npm run test:pg && npm run test",
    "sweep": "tsx scripts/sweep.ts",
    "search": "tsx scripts/search.ts",
    "inspect": "tsx scripts/inspect.ts",
    "score-policies": "tsx scripts/score-policies.ts",
    "brief-sweep": "tsx scripts/brief-sweep.ts",
    "seed-roster": "tsx scripts/seed-roster.ts",
    "refresh-ratings": "tsx scripts/refresh-ratings.ts",
    "portrait-gallery": "tsx scripts/portrait-gallery.ts",
    "backfill-characters": "tsx scripts/backfill-characters.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "serve": "tsx scripts/serve.ts",
    "test:pg": "scripts/pg-test.sh",
    "start": "tsx scripts/serve.ts --migrate"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "playwright": "^1.63.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@electric-sql/pglite": "^0.5.8",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "bs58": "^6.0.0",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "tsx": "^4.19.2",
    "tweetnacl": "^1.0.3",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=24"
  }
}
